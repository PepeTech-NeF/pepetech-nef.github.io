---
import site from '../data/site.json';
import { resolve } from 'node:path';
import { listStickerUrls } from '../lib/stickers.js';
import { getContacts } from '../lib/contacts.js';
import HeaderContact from '../components/HeaderContact.astro';

const categoryFiles = import.meta.glob('../data/categories/*.json', { eager: true, import: 'default' });
const countryFiles = import.meta.glob('../data/countries/*.json', { eager: true, import: 'default' });
const categoryEntries = Object.values(categoryFiles)
  .filter((item) => item && item.code && item.label)
  .sort((a, b) => (Number(a.order) || 999) - (Number(b.order) || 999) || a.label.localeCompare(b.label, 'ru'));
const categories = Object.fromEntries(categoryEntries.map((item) => [item.code, item.label]));
const countryLabels = Object.fromEntries(
  Object.values(countryFiles).filter((item) => item && item.code && item.label).map((item) => [item.code, item.label]),
);

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const assetUrl = (path) => root + '/' + String(path).replace(/^\/+/, '');
const files = import.meta.glob('../data/builds/*.json', { eager: true, import: 'default' });
const builds = Object.values(files)
  .filter((item) => item && item.published !== false && item.title)
  .map((item) => ({
    ...item,
    category: String(item.category || 'other').trim(),
    country: String(item.country ?? '').trim(),
    countryLabel: countryLabels[String(item.country ?? '').trim()] || String(item.country ?? '').trim(),
    images: Array.isArray(item.images) ? item.images.filter(Boolean).slice(0, 2).map(assetUrl) : [],
  }))
  .sort((a, b) => a.title.localeCompare(b.title, 'ru'));
const activeCategories = categoryEntries.filter((entry) => builds.some((item) => item.category === entry.code));
const countries = [...new Set(builds.map((item) => item.country).filter(Boolean))]
  .map((code) => ({ code, label: countryLabels[code] || code }))
  .sort((a, b) => a.label.localeCompare(b.label, 'ru'));
const contacts = getContacts(site);
const stickers = listStickerUrls(resolve(process.cwd(), 'public/images/Стикеры'), root);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0e1011" />
    <title>{site.title}</title>
    <link rel="stylesheet" href={root + "/styles.css"} />
  </head>
  <body>
    <div class="sticker-backdrop" data-stickers={JSON.stringify(stickers)} aria-hidden="true"></div>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href={root + "/"} aria-label="PepeTech - на главную">
          <span class="mark" aria-hidden="true">PT</span>
          <span class="brand-lockup">
            <span class="brand-name">{site.brand}</span>
            <span class="brand-caption">Проект на PepeLand 11 by nef1c</span>
          </span>
        </a>
        {contacts.length > 0 && <div class={`header-contact-area header-contact-count-${contacts.length}`}>
          <nav class="header-contact-grid" aria-label="Контакты">
            {contacts.map((contact) => <HeaderContact contact={contact} />)}
          </nav>
          <details class="header-contact-menu">
            <summary class="header-menu-trigger" aria-label="Контакты" title="Контакты">
              <svg class="header-menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-3.8-.85L3 21l1.85-5.7A9 9 0 0 1 4 11.5 8.5 8.5 0 0 1 12.5 3 8.5 8.5 0 0 1 21 11.5Z"/></svg>
              <span class="header-menu-label">Контакты</span>
            </summary>
            <div class="header-mobile-panel">
              {contacts.map((contact) => <HeaderContact contact={contact} />)}
            </div>
          </details>
        </div>}
      </div>
    </header>
    <main class="wrap">
      <section class="catalog" aria-label="Портфолио техники">
        <div class="catalog-head">
          <div>
            <p class="eyebrow catalog-kicker">РАБОТЫ / PEPELAND</p>
            <h1>{site.heading}</h1>
          </div>
          <p class="catalog-subline">{site.description}</p>
        </div>
        <div class="toolbar" hidden={builds.length === 0}>
          <div class="filters" role="group" aria-label="Категории">
            <button class="filter" type="button" data-filter="all" aria-pressed="true">Все</button>
            {activeCategories.map((category) => <button class="filter" type="button" data-filter={category.code} aria-pressed="false">{category.label}</button>)}
          </div>
          <div class="tools">
            {countries.length > 0 && <select class="country-select" id="country" aria-label="Страна">
              <option value="">Все страны</option>
              {countries.map((country) => <option value={country.code}>{country.label}</option>)}
            </select>}
            <label class="search">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
              <input id="search" type="search" placeholder="Поиск техники" aria-label="Поиск техники" autocomplete="off" />
            </label>
          </div>
        </div>
        <div class="results-row" hidden={builds.length === 0}>
          <p class="results" id="results" aria-live="polite">Найдено: {builds.length}</p>
          <span class="results-note">Выберите модель для просмотра</span>
        </div>
        <div class="grid" id="gallery">
          {builds.map((item) => <article class="card" data-card data-category={item.category} data-country={item.country} data-search={[item.title, item.description ?? "", item.countryLabel].join(" ")} data-title={item.title} data-images={JSON.stringify(item.images)}>
            <button class="card-button" type="button" data-open disabled={!item.images.length} aria-label={"Открыть " + item.title}>
              <span class="cover">
                {item.images.length ? <img src={item.images[0]} alt={"Техника «" + item.title + "»"} loading="lazy" decoding="async" /> : <svg class="placeholder" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m3 17 5-5 4 4 3-3 6 5"/></svg>}
                {item.images.length > 0 && <span class="cover-cta" aria-hidden="true">ОТКРЫТЬ <span>↗</span></span>}
              </span>
              <span class="card-meta">
                <span class="card-copy">
                  <span class="card-title">{item.title}</span>
                  <span class="card-category">{categories[item.category] || item.category}{item.country ? ' / ' + item.countryLabel : ''}</span>
                </span>
              </span>
            </button>
            {item.description && <p class="card-description">{item.description}</p>}
          </article>)}
        </div>
        <div class="empty" id="empty" hidden={builds.length > 0}>
          <div><strong id="empty-title">Пока нет техники</strong><p id="empty-text">Новые работы появятся здесь.</p></div>
        </div>
      </section>
    </main>
    <footer class="foot">
      <div class="wrap">
        <div class="footer-content">
          <div class="footer-identity">
            <strong>PepeTech</strong>
            <span>Проект nef1c · Minecraft</span>
          </div>
          {contacts.length > 0 && <nav class="footer-contacts" aria-label="Контакты в подвале">
            {contacts.map((contact) => <HeaderContact contact={contact} />)}
          </nav>}
        </div>
        <div class="footer-bottom">
          <span>Сайт создал g_633 из Trivium</span>
        </div>
      </div>
    </footer>
    <dialog class="viewer" id="viewer" aria-label="Просмотр фотографий">
      <div class="viewer-head"><h2 id="viewer-title"></h2><button class="viewer-close" id="viewer-close" type="button" aria-label="Закрыть">×</button></div>
      <div class="viewer-image-wrap"><img id="viewer-image" alt="" /><button class="viewer-nav" id="prev" type="button" aria-label="Предыдущее фото">‹</button><button class="viewer-nav" id="next" type="button" aria-label="Следующее фото">›</button></div>
      <div class="viewer-foot"><span class="counter" id="counter"></span></div>
    </dialog>
    <script is:inline src={root + "/app.js"} defer></script>
    <script is:inline src={root + "/stickers.js"} defer></script>
  </body>
</html>
