---
import site from '../data/site.json';

const categories = {
  houses: 'Дома',
  shops: 'Магазины',
  farms: 'Фермы',
  public: 'Общественные',
  decor: 'Декорации',
  other: 'Другое',
};

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const assetUrl = (path) => root + '/' + String(path).replace(/^\/+/, '');
const files = import.meta.glob('../data/builds/*.json', { eager: true, import: 'default' });
const builds = Object.values(files)
  .filter((item) => item && item.published !== false && item.title)
  .map((item) => ({
    ...item,
    category: categories[item.category] ? item.category : 'other',
    images: Array.isArray(item.images) ? item.images.filter(Boolean).slice(0, 2).map(assetUrl) : [],
  }))
  .sort((a, b) => a.title.localeCompare(b.title, 'ru'));
const activeCategories = Object.keys(categories).filter((key) => builds.some((item) => item.category === key));
const contacts = [
  { label: 'Discord', url: site.discord },
  { label: 'Telegram', url: site.telegram },
].filter((contact) => /^https:\/\//.test(contact.url));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#101114" />
    <title>{site.title}</title>
    <link rel="stylesheet" href={root + "/styles.css"} />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={root + "/"} aria-label="Главная"><span class="mark">P</span><span>{site.brand}</span></a>
        <nav class="top-links" aria-label="Контакты">
          {contacts.map((contact) => <a class="link" href={contact.url} target="_blank" rel="noopener noreferrer">{contact.label} ↗</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <section class="intro">
        <p class="eyebrow">PepeLand / Каталог</p>
        <h1>{site.heading}</h1>
        <p class="lead">{site.description}</p>
      </section>
      <section aria-label="Галерея построек">
        <div class="toolbar">
          <div class="filters" aria-label="Категории">
            <button class="filter" type="button" data-filter="all" aria-pressed="true">Все</button>
            {activeCategories.map((category) => <button class="filter" type="button" data-filter={category} aria-pressed="false">{categories[category]}</button>)}
          </div>
          <label class="search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
            <input id="search" type="search" placeholder="Поиск построек" aria-label="Поиск построек" autocomplete="off" />
          </label>
        </div>
        <p class="results" id="results">{builds.length} {builds.length === 1 ? 'постройка' : 'построек'}</p>
        <div class="grid" id="gallery">
          {builds.map((item) => <article class="card" data-card data-category={item.category} data-search={[item.title, item.description ?? "", item.code ?? ""].join(" ")} data-title={item.title} data-images={JSON.stringify(item.images)}>
            <button class="card-button" type="button" data-open disabled={!item.images.length} aria-label={"Открыть " + item.title}>
              <span class="cover">
                {item.images.length ? <img src={item.images[0]} alt={"Постройка «" + item.title + "»"} loading="lazy" decoding="async" /> : <svg class="placeholder" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m3 17 5-5 4 4 3-3 6 5"/></svg>}
              </span>
              <span class="card-meta"><span class="card-title">{item.title}</span><span class="card-category">{categories[item.category]}</span></span>
            </button>
            {item.description && <p class="card-description">{item.description}</p>}
          </article>)}
        </div>
        <div class="empty" id="empty" hidden={builds.length > 0}>
          <div><strong id="empty-title">Пока нет построек</strong><p id="empty-text">Здесь появятся первые работы.</p></div>
        </div>
      </section>
    </main>
    <footer class="foot"><div class="wrap"><span>{site.brand} · Каталог построек</span><span>PepeLand</span></div></footer>
    <dialog class="viewer" id="viewer" aria-label="Просмотр фотографий">
      <div class="viewer-head"><h2 id="viewer-title"></h2><button class="viewer-close" id="viewer-close" type="button" aria-label="Закрыть">×</button></div>
      <div class="viewer-image-wrap"><img id="viewer-image" alt="" /><button class="viewer-nav" id="prev" type="button" aria-label="Предыдущее фото">‹</button><button class="viewer-nav" id="next" type="button" aria-label="Следующее фото">›</button></div>
      <div class="viewer-foot"><span class="counter" id="counter"></span><div class="contact-links">{contacts.map((contact) => <a class="link" href={contact.url} target="_blank" rel="noopener noreferrer">Написать в {contact.label} ↗</a>)}</div></div>
    </dialog>
    <script is:inline src={root + "/app.js"} defer></script>
  </body>
</html>
